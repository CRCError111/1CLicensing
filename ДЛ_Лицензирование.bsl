&НаСервере
Функция Лице_ЗагрузитьЛицензиюИзХранилища()
	
	// Пробуем загрузить из разных мест по порядку приоритета
	
	// 1. Файл лицензии (наиболее надежное)
	Лицензия = Лице_ЗагрузитьЛицензиюИзФайла();
	Если Лицензия <> Неопределено Тогда
		Возврат Лицензия;
	КонецЕсли;
	
	// 2. Реестр Windows (только Windows)
	Лицензия = Лице_ЗагрузитьЛицензиюИзРеестра();
	Если Лицензия <> Неопределено Тогда
		Возврат Лицензия;
	КонецЕсли;
	
	// 3. Таблица в базе данных
	Лицензия = Лице_ЗагрузитьЛицензиюИзБД();
	Если Лицензия <> Неопределено Тогда
		Возврат Лицензия;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция Лице_ЗагрузитьЛицензиюИзФайла()
	
	Попытка
		
		ПутьКФайлу = КаталогДанных() + "infostart_license.dat";
		
		Если Не ФайлСуществует(ПутьКФайлу) Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Чтение = Новый ЧтениеТекста;
		Чтение.Открыть(ПутьКФайлу);
		ЗакодированныеДанные = Чтение.Прочитать();
		Чтение.Закрыть();
		
		// Декодируем Base64
		Декодированные = Лице_ДекодироватьBase64(ЗакодированныеДанные);
		
		// Расшифровываем
		Расшифрованные = Лице_РасшифроватьДанные(Декодированные);
		
		// Парсим лицензию
		Лицензия = Лице_РазобратьЛицензиюИзСтроки(Расшифрованные);
		
		Возврат Лицензия;
		
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция Лице_ЗагрузитьЛицензиюИзРеестра()
	
	// Только для Windows
	Если Прав(ОС, 3) <> "Win" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		
		// Используем безопасное хранилище вместо реестра (кроссплатформенно)
		ИмяХранилища = "1CExtLicense_" + Лице_ПолучитьHWID();
		ЗакодированныеДанные = ПолучитьБезопасноеХранилище().Получить(ИмяХранилища);
		
		Если ЗакодированныеДанные = Неопределено Или ЗакодированныеДанные = "" Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		// Декодируем и расшифровываем
		Декодированные = Лице_ДекодироватьBase64(ЗакодированныеДанные);
		Расшифрованные = Лице_РасшифроватьДанные(Декодированные);
		
		Лицензия = Лице_РазобратьЛицензиюИзСтроки(Расшифрованные);
		
		Возврат Лицензия;
		
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция Лице_ЗагрузитьЛицензиюИзБД()
	
	Попытка
		
		// Проверяем существование таблицы через выполнение запроса
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ЛицензияДанные КАК Данные
			|ИЗ ИнформационнаяБаза." + Лице_Константа_ИмяТаблицыБД() + " КАК Лицензия";
		
		Результат = Запрос.Выполнить();
		
		Если Результат.Пустой() Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Выборка = Результат.Выбрать();
		Если Выборка.Следующий() Тогда
			ЗакодированныеДанные = Выборка.Данные;
			
			// Декодируем и расшифровываем
			Декодированные = Лице_ДекодироватьBase64(ЗакодированныеДанные);
			Расшифрованные = Лице_РасшифроватьДанные(Декодированные);
			
			Лицензия = Лице_РазобратьЛицензиюИзСтроки(Расшифрованные);
			
			Возврат Лицензия;
		КонецЕсли;
		
	Исключение
		// Таблица не существует или другая ошибка
	КонецПопытки;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
