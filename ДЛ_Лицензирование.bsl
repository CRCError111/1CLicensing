&НаСервере
Функция Лице_ВычислитьХеш(Строка)
	
	// Простая хеш-функция (в рамках возможностей 1С без стороннего ПО)
	// Используем алгоритм на основе полиномиального хеширования
	
	Попытка
		
		Хеш1 = 0;
		Хеш2 = 0;
		Множитель1 = 31;
		Множитель2 = 37;
		Модуль = 2147483647; // 2^31 - 1
		
		Для Счетчик = 1 По СтрДлина(Строка) Цикл
			
			КодСимвола = КодСимвола(Строка, Счетчик);
			
			Хеш1 = (Хеш1 * Множитель1 + КодСимвола) % Модуль;
			Хеш2 = (Хеш2 * Множитель2 + КодСимвола) % Модуль;
			
		КонецЦикла;
		
		// Объединяем два хеша для увеличения энтропии
		ХешСтрока = "";
		
		// Преобразуем первый хеш
		Временный = Хеш1;
		Пока Временный > 0 Цикл
			Остаток = Временный % 16;
			Если Остаток < 10 Тогда
				ХешСтрока = Строка(Остаток) + ХешСтрока;
			Иначе
				ХешСтрока = Символ(КодСимвола("A") + Остаток - 10) + ХешСтрока;
			КонецЕсли;
			Временный = Цел(Временный / 16);
		КонецЦикла;
		
		// Дополняем до 16 символов
		Пока СтрДлина(ХешСтрока) < 16 Цикл
			ХешСтрока = "0" + ХешСтрока;
		КонецЦикла;
		
		// Преобразуем второй хеш
		ХешСтрока2 = "";
		Временный = Хеш2;
		Пока Временный > 0 Цикл
			Остаток = Временный % 16;
			Если Остаток < 10 Тогда
				ХешСтрока2 = Строка(Остаток) + ХешСтрока2;
			Иначе
				ХешСтрока2 = Символ(КодСимвола("A") + Остаток - 10) + ХешСтрока2;
			КонецЕсли;
			Временный = Цел(Временный / 16);
		КонецЦикла;
		
		Пока СтрДлина(ХешСтрока2) < 16 Цикл
			ХешСтрока2 = "0" + ХешСтрока2;
		КонецЦикла;
		
		Возврат ХешСтрока + ХешСтрока2;
		
	Исключение
		Возврат "00000000000000000000000000000000";
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция Лице_КодироватьBase64(Строка)
	
	// Используем встроенные средства 1С для кодирования Base64
	Попытка
		
		// Преобразуем строку в двоичные данные через ПотокВПамяти
		Поток = Новый ПотокВПамяти;
		ЗаписьТекста = Новый ЗаписьТекста(Поток, КодировкаТекста.UTF8);
		ЗаписьТекста.Записать(Строка);
		ЗаписьТекста.Закрыть();
		
		Поток.ПерейтиКНачалу();
		ДвоичныеДанные = Поток.ПолучитьБазовыйПоток().ПолучитьДвоичныеДанные();
		
		// Кодируем в Base64
		Кодированные = Base64Значение(ДвоичныеДанные);
		
		Возврат Кодированные;
		
	Исключение
		// Если не получилось, возвращаем как есть
		Возврат Строка;
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция Лице_ДекодироватьBase64(КодированнаяСтрока)
	
	Попытка
		
		// Декодируем Base64
		ДвоичныеДанные = Base64Значение(КодированнаяСтрока);
		
		// Преобразуем обратно в строку
		Возврат ДвоичныеДанные.ПолучитьСтроку();
		
	Исключение
		// Если не получилось, возвращаем как есть
		Возврат КодированнаяСтрока;
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция Лице_ЗашифроватьДанные(Данные)
	
	// Простое шифрование XOR с ключом
	// В рамках возможностей 1С без стороннего ПО
	
	Ключ = Лице_Константа_КлючПроверки();
	ДлинаКлюча = СтрДлина(Ключ);
	Результат = "";
	
	Для Счетчик = 1 По СтрДлина(Данные) Цикл
		
		// Получаем код символа данных
		КодДанных = КодСимвола(Данные, Счетчик);
		
		// Получаем код символа ключа (циклически)
		ПозицияКлюча = ((Счетчик - 1) % ДлинаКлюча) + 1;
		КодКлюча = КодСимвола(Ключ, ПозицияКлюча);
		
		// Применяем XOR
		ЗашифрованныйКод = БитИскИли(КодДанных, КодКлюча % 256);
		
		// Добавляем символ к результату
		Результат = Результат + Символ(ЗашифрованныйКод);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция Лице_РасшифроватьДанные(Данные)
	
	// Дешифрование XOR (та же операция что и шифрование)
	Возврат Лице_ЗашифроватьДанные(Данные);
	
КонецФункции

&НаСервере
Функция Лице_СериализоватьЛицензию(Лицензия)
	
	// Сериализуем структуру лицензии в строку формата KEY=VALUE
	
	Строка = 
		"HWID=" + Лицензия.HWID + ";" +
		"StartDate=" + Формат(Лицензия.ДатаНачала, "ДФ=yyyyMMdd") + ";" +
		"EndDate=" + Формат(Лицензия.ДатаОкончания, "ДФ=yyyyMMdd") + ";" +
		"Signature=" + Лицензия.Подпись + ";" +
		"ActivationDate=" + Формат(Лицензия.ДатаАктивации, "ДФ=yyyyMMddHHmmss");
	
	Возврат Строка;
	
КонецФункции

&НаСервере
Функция Лице_РазобратьЛицензиюИзСтроки(Строка)
	
	Попытка
		
		Лицензия = Новый Структура;
		
		// Разбиваем на пары KEY=VALUE
		Пары = СтрРазделить(Строка, ";", Ложь);
		
		Для Каждого Пара Из Пары Цикл
			
			Части = СтрРазделить(Пара, "=", Ложь);
			
			Если Части.Количество() >= 2 Тогда
				
				Ключ = Части[0];
				// Собираем значение (может содержать "=")
				Значение = СтрСоединить(Части.ВыгрузитьЗначения(1), "=");
				
				Если Ключ = "HWID" Тогда
					Лицензия.Вставить("HWID", Значение);
					
				ИначеЕсли Ключ = "StartDate" Тогда
					Год = Число(Лев(Значение, 4));
					Месяц = Число(Сред(Значение, 4, 2));
					День = Число(Прав(Значение, 2));
					Лицензия.Вставить("ДатаНачала", Дата(Год, Месяц, День));
					
				ИначеЕсли Ключ = "EndDate" Тогда
					Год = Число(Лев(Значение, 4));
					Месяц = Число(Сред(Значение, 4, 2));
					День = Число(Прав(Значение, 2));
					Лицензия.Вставить("ДатаОкончания", Дата(Год, Месяц, День));
					
				ИначеЕсли Ключ = "Signature" Тогда
					Лицензия.Вставить("Подпись", Значение);
					
				ИначеЕсли Ключ = "ActivationDate" Тогда
					Год = Число(Лев(Значение, 4));
					Месяц = Число(Сред(Значение, 4, 2));
					День = Число(Сред(Значение, 6, 2));
					Часы = Число(Сред(Значение, 8, 2));
					Минуты = Число(Сред(Значение, 10, 2));
					Секунды = Число(Прав(Значение, 2));
					Лицензия.Вставить("ДатаАктивации", ДатаВремя(Год, Месяц, День, Часы, Минуты, Секунды));
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		// Проверяем наличие всех обязательных полей
		Если Лицензия.Свойство("HWID") И 
		   Лицензия.Свойство("ДатаНачала") И 
		   Лицензия.Свойство("ДатаОкончания") И 
		   Лицензия.Свойство("Подпись") Тогда
			Возврат Лицензия;
		КонецЕсли;
		
	Исключение
	КонецПопытки;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция Лице_ПроверитьЛицензиюВалидность(Лицензия)
	
	// Проверяем наличие всех необходимых полей
	
	Если Не Лицензия.Свойство("HWID") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не Лицензия.Свойство("ДатаНачала") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не Лицензия.Свойство("ДатаОкончания") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не Лицензия.Свойство("Подпись") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Проверяем длину подписи (защита от простых подделок)
	Если СтрДлина(Лицензия.Подпись) < 10 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Проверяем логичность дат
	Если Лицензия.ДатаОкончания <= Лицензия.ДатаНачала Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// УПРАВЛЕНИЕ ДЕМО-ПЕРИОДОМ
////////////////////////////////////////////////////////////////////////////////

&НаСервере
Функция Лице_ПолучитьДатуУстановки()
	
	Попытка
		
		// Пробуем получить из файла
		ПутьКФайлу = КаталогДанных() + "infostart_install_date.dat";
		
		Если ФайлСуществует(ПутьКФайлу) Тогда
			
			Чтение = Новый ЧтениеТекста;
			Чтение.Открыть(ПутьКФайлу);
			СтрокаДаты = Чтение.Прочитать();
			Чтение.Закрыть();
			
			Год = Число(Лев(СтрокаДаты, 4));
			Месяц = Число(Сред(СтрокаДаты, 4, 2));
			День = Число(Прав(СтрокаДаты, 2));
			
			ДатаУстановки = Дата(Год, Месяц, День);
			
			Возврат ДатаУстановки;
			
		КонецЕсли;
		
	Исключение
	КонецПопытки;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Процедура Лице_СохранитьДатуУстановки(Дата)
	
	Попытка
		
		ПутьКФайлу = КаталогДанных() + "infostart_install_date.dat";
		СтрокаДаты = Формат(Дата, "ДФ=yyyyMMdd");
		
		Запись = Новый ЗаписьТекста;
		Запись.Открыть(ПутьКФайлу);
		Запись.Записать(СтрокаДаты);
		Запись.Закрыть();
		
	Исключение
	КонецПопытки;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СОЗДАНИЕ СТАТУСА ЛИЦЕНЗИИ
////////////////////////////////////////////////////////////////////////////////

&НаСервере
Функция Лице_СоздатьСтатус(Код, Сообщение, Лицензия = Неопределено, ОсталосьДней = 0)
	
	Статус = Новый Структура;
	Статус.Вставить("Код", Код);
	Статус.Вставить("Сообщение", Сообщение);
	Статус.Вставить("Активна", Код = "active" Или Код = "trial");
	Статус.Вставить("Лицензия", Лицензия);
	Статус.Вставить("ОсталосьДней", ОсталосьДней);
	
	КодСостояния = -1;
	Если Код = "active" Тогда
		КодСостояния = 1;
	ИначеЕсли Код = "trial" Тогда
		КодСостояния = 2;
	ИначеЕсли Код = "debug_detected" Тогда
		КодСостояния = -3;
	ИначеЕсли Код = "module_corrupted" Тогда
		КодСостояния = -2;
	КонецЕсли;
	
	Статус.Вставить("КодСостояния", КодСостояния);
	
	Возврат Статус;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ЗАЩИТА ОТ ВЗЛОМА
////////////////////////////////////////////////////////////////////////////////

&НаСервере
Функция Лице_ПроверитьОтладку()
	
	// Проверка наличия отладчика
	// В 1С нет прямого API для определения отладки, но можно использовать косвенные признаки
	
	Попытка
		
		// Проверяем время выполнения операций (отладка замедляет работу)
		ВремяНачало = ТекущаяДата();
		
		// Выполняем простую операцию
		Сумма = 0;
		Для Счетчик = 1 По 1000 Цикл
			Сумма = Сумма + Счетчик;
		КонецЦикла;
		
		ВремяКонец = ТекущаяДата();
		Разница = ВремяКонец - ВремяНачало;
		
		// Если операция заняла слишком много времени, возможно идет отладка
		// 0.0001 секунды = 1/864000000 дня
		Если Разница > 0.0001 Тогда
			// Это не обязательно отладка, может быть медленный сервер
			// Поэтому не блокируем, а просто логируем
		КонецЕсли;
		
	Исключение
	КонецПопытки;
	
	// В реальной системе здесь можно добавить больше проверок
	Возврат Ложь;
	
КонецФункции

&НаСервере
Функция Лице_ПроверитьЦелостностьМодуля()
	
	// Проверка целостности модуля
	// В идеале нужно хранить эталонную контрольную сумму модуля
	
	Попытка
		
		// Проверяем наличие ключевых функций в модуле
		Методы = ЭтотОбъект.Метод();
		
		КлючевыеМетоды = Новый Массив;
		КлючевыеМетоды.Добавить("Лице_ВыполнитьПроверку");
		КлючевыеМетоды.Добавить("Лице_ПолучитьHWID");
		КлючевыеМетоды.Добавить("Лице_ЗагрузитьЛицензию");
		
		Для Каждого Метод Из КлючевыеМетоды Цикл
			Если Методы.Найти(Метод) = -1 Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
		
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

#КонецЕсли
