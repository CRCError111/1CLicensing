////////////////////////////////////////////////////////////////////////////////
// ОСНОВНАЯ ФУНКЦИЯ ПРОВЕРКИ ЛИЦЕНЗИИ
////////////////////////////////////////////////////////////////////////////////

&НаСервере
Функция Лице_ВыполнитьПроверку(Подробно = Ложь)
	
	// === УРОВЕНЬ 1: Проверка на отладку ===
	Если Лице_ПроверитьОтладку() Тогда
		Если Подробно Тогда
			Возврат Лице_СоздатьСтатус("debug_detected", "Обнаружена отладка. Работа невозможна.");
		Иначе
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	// === УРОВЕНЬ 2: Проверка целостности модуля ===
	Если Не Лице_ПроверитьЦелостностьМодуля() Тогда
		Если Подробно Тогда
			Возврат Лице_СоздатьСтатус("module_corrupted", "Модуль поврежден или изменен.");
		Иначе
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	// === УРОВЕНЬ 3: Попытка загрузки лицензии из всех источников ===
	Лицензия = Лице_ЗагрузитьЛицензиюИзХранилища();
	
	Если Лицензия = Неопределено Тогда
		// Лицензия не найдена, проверяем демо-период
		Возврат Лице_ПроверитьДемоПериод(Подробно);
	КонецЕсли;
	
	// === УРОВЕНЬ 4: Проверка валидности структуры лицензии ===
	Если Не Лице_ПроверитьЛицензиюВалидность(Лицензия) Тогда
		Если Подробно Тогда
			Возврат Лице_СоздатьСтатус("license_invalid", "Лицензия имеет неверный формат.");
		Иначе
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	// === УРОВЕНЬ 5: Проверка HWID (привязка к оборудованию) ===
	ТекущийHWID = Лице_ПолучитьHWID();
	Если Лицензия.HWID <> ТекущийHWID Тогда
		Если Подробно Тогда
			Возврат Лице_СоздатьСтатус("hwid_mismatch", "Лицензия выдана для другого компьютера/базы.");
		Иначе
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	// === УРОВЕНЬ 6: Проверка срока действия лицензии ===
	Если Лицензия.ДатаОкончания < ТекущаяДата() Тогда
		Если Подробно Тогда
			Возврат Лице_СоздатьСтатус("license_expired", "Срок действия лицензии истек.");
		Иначе
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	// === УРОВЕНЬ 7: Проверка даты начала (защита от подделки времени) ===
	Если Лицензия.ДатаНачала > ТекущаяДата() Тогда
		Если Подробно Тогда
			Возврат Лице_СоздатьСтатус("license_future", "Некорректная дата начала лицензии.");
		Иначе
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	// Все проверки пройдены
	Если Подробно Тогда
		ДнейДоКонца = РазницаДат(ТекущаяДата(), Лицензия.ДатаОкончания, "День");
		Возврат Лице_СоздатьСтатус("active", "Лицензия активна. Дней осталось: " + ДнейДоКонца, Лицензия, ДнейДоКонца);
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// БЫСТРАЯ ПРОВЕРКА (для частых вызовов)
////////////////////////////////////////////////////////////////////////////////

&НаСервере
Функция Лице_БыстраяПроверка()
	
	// Кэшируем результат на 1 минуту с использованием локальных переменных
	// В общих модулях 1С нельзя использовать глобальные переменные, 
	// поэтому используем параметры сеанса или вычисляем каждый раз
	
	// Выполняем полную проверку (кэширование на уровне сеанса можно добавить отдельно)
	Возврат Лице_ВыполнитьПроверку(Ложь);
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ПРОВЕРКА ДЕМО-ПЕРИОДА
////////////////////////////////////////////////////////////////////////////////

&НаСервере
Функция Лице_ПроверитьДемоПериод(Подробно = Ложь)
	
	Попытка
		
		// Получаем дату первой установки расширения
		ДатаУстановки = Лице_ПолучитьДатуУстановки();
		
		Если ДатаУстановки = Неопределено Тогда
			// Первая установка, сохраняем текущую дату
			ДатаУстановки = ТекущаяДата();
			Лице_СохранитьДатуУстановки(ДатаУстановки);
		КонецЕсли;
		
		// Вычисляем сколько дней прошло
		ДнейПрошло = РазницаДат(ТекущаяДата(), ДатаУстановки, "День");
		
		Если ДнейПрошло <= Лице_Константа_СрокДемо() Тогда
			
			ОсталосьДней = Лице_Константа_СрокДемо() - ДнейПрошло;
			
			Если Подробно Тогда
				Сообщение = "Демо-режим активен. Осталось дней: " + ОсталосьДней;
				Если ОсталосьДней <= 3 Тогда
					Сообщение = Сообщение + ". Рекомендуется приобрести лицензию!";
				КонецЕсли;
				Возврат Лице_СоздатьСтатус("trial", Сообщение, , ОсталосьДней);
			Иначе
				Возврат Истина;
			КонецЕсли;
			
		Иначе
			
			// Демо-период завершен
			Если Подробно Тогда
				Возврат Лице_СоздатьСтатус("trial_expired", 
					"Демо-период (" + Лице_Константа_СрокДемо() + " дн.) завершен. " +
					"Для продолжения работы необходимо приобрести лицензию.");
			Иначе
				Возврат Ложь;
			КонецЕсли;
			
		КонецЕсли;
		
	Исключение
		
		// При ошибке все равно даем доступ (чтобы не блокировать работу)
		// Но логируем ошибку для администратора
		Если Подробно Тогда
			Возврат Лице_СоздатьСтатус("error", 
				"Ошибка проверки демо-режима: " + ОписаниеОшибки() + 
				". Обратитесь к администратору.");
		Иначе
			Возврат Истина;
		КонецЕсли;
		
	КонецПопытки;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ФОРМИРОВАНИЕ ЗАПРОСА ЛИЦЕНЗИИ
////////////////////////////////////////////////////////////////////////////////

&НаСервере
Функция Лице_СформироватьЗапрос()
	
	Попытка
		
		// Получаем уникальный идентификатор оборудования
		HWID = Лице_ПолучитьHWID();
		
		// Текущая дата и время
		ДатаЗапроса = ТекущаяДата();
		
		// Версия платформы 1С
		ВерсияПлатформы = ВерсияПриложения();
		
		// Уникальный случайный идентификатор запроса (защита от повторного использования)
		УникальныйID = Лице_ПолучитьУникальныйИдентификатор();
		
		// Формируем строку запроса
		СтрокаЗапроса = 
			"REQUEST_LICENSE" + "|" +
			HWID + "|" +
			Формат(ДатаЗапроса, "ДФ=yyyyMMddHHmmss") + "|" +
			ВерсияПлатформы + "|" +
			УникальныйID;
		
		// Добавляем контрольную сумму для защиты от модификации
		КонтрольнаяСумма = Лице_ВычислитьХеш(СтрокаЗапроса + Лице_Константа_КлючПроверки());
		СтрокаЗапроса = СтрокаЗапроса + "|" + КонтрольнаяСумма;
		
		// Кодируем в Base64 для удобной передачи
		ЗакодированныйЗапрос = Лице_КодироватьBase64(СтрокаЗапроса);
		
		// Формируем итоговый текст для пользователя
		ТекстДляКопирования = 
			"=== ЗАПРОС ЛИЦЕНЗИИ ===" + Символы.ПС +
			"Скопируйте этот текст и отправьте разработчику:" + Символы.ПС + Символы.ПС +
			ЗакодированныйЗапрос + Символы.ПС + Символы.ПС +
			"=======================";
		
		Возврат ТекстДляКопирования;
		
	Исключение
		Возврат "ERROR: Не удалось сформировать запрос. " + ОписаниеОшибки();
	КонецПопытки;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ЗАГРУЗКА И АКТИВАЦИЯ ЛИЦЕНЗИИ
////////////////////////////////////////////////////////////////////////////////

&НаСервере
Процедура Лице_ЗагрузитьЛицензию(ТекстОтвета)
	
	Попытка
		
		// Извлекаем закодированную часть из текста ответа
		ЗакодированныйОтвет = Лице_ИзвлечьЛицензиюИзТекста(ТекстОтвета);
		
		Если ЗакодированныйОтвет = "" Тогда
			ВызватьИсключение "Не удалось найти лицензию в тексте ответа. Проверьте формат.";
		КонецЕсли;
		
		// Декодируем Base64
		ДекодированныйОтвет = Лице_ДекодироватьBase64(ЗакодированныйОтвет);
		
		// Разбираем части ответа
		Части = СтрРазделить(ДекодированныйОтвет, "|", Ложь);
		
		Если Части.Количество() < 6 Тогда
			ВызватьИсключение "Неверный формат ответа. Ожидалось минимум 6 полей, получено: " + Части.Количество();
		КонецЕсли;
		
		// Проверяем тип ответа
		Если Части[0] <> "RESPONSE_LICENSE" Тогда
			ВызватьИсключение "Неверный тип ответа. Ожидался RESPONSE_LICENSE, получено: " + Части[0];
		КонецЕсли;
		
		// Извлекаем данные лицензии
		HWID = Части[1];
		ГодНачала = Число(Части[2]);
		ГодОкончания = Число(Части[3]);
		Подпись = Части[4];
		КонтрольнаяСумма = Части[5];
		
		// Проверяем контрольную сумму
		СтрокаДляПроверки = HWID + "|" + Части[2] + "|" + Части[3] + "|" + Подпись;
		ОжидаемаяСумма = Лице_ВычислитьХеш(СтрокаДляПроверки + Лице_Константа_КлючПроверки());
		
		Если ОжидаемаяСумма <> КонтрольнаяСумма Тогда
			ВызватьИсключение "Неверная контрольная сумма. Ответ мог быть изменен.";
		КонецЕсли;
		
		// Проверяем HWID текущего компьютера
		ТекущийHWID = Лице_ПолучитьHWID();
		Если HWID <> ТекущийHWID Тогда
			ВызватьИсключение "Лицензия выдана для другого компьютера или базы данных." + Символы.ПС +
				"HWID в лицензии: " + HWID + Символы.ПС +
				"Текущий HWID: " + ТекущийHWID;
		КонецЕсли;
		
		// Создаем объект лицензии
		Лицензия = Новый Структура;
		Лицензия.Вставить("HWID", HWID);
		Лицензия.Вставить("ДатаНачала", Дата(ГодНачала, 1, 1));
		Лицензия.Вставить("ДатаОкончания", Дата(ГодОкончания, 12, 31));
		Лицензия.Вставить("Подпись", Подпись);
		Лицензия.Вставить("ДатаАктивации", ТекущаяДата());
		
		// Сохраняем лицензию во все хранилища
		Лице_СохранитьЛицензиюВХранилище(Лицензия);
		
		// Очищаем кэш
		Лице_ЛицензияКэш = Неопределено;
		Лице_ПоследняяПроверка = Неопределено;
		
	Исключение
		ВызватьИсключение "Ошибка активации лицензии: " + ОписаниеОшибки();
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Функция Лице_ИзвлечьЛицензиюИзТекста(Текст)
	
	// Ищем строку с закодированной лицензией
	Строки = СтрРазделить(Текст, Символы.ПС, Ложь);
	
	Для Каждого Строка Из Строки Цикл
		// Пропускаем служебные строки
		Если СтрНачинаетсяС(Строка, "===") Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНачинаетсяС(Строка, "Скопируйте") Или СтрНачинаетсяС(Строка, "Отправьте") Тогда
			Продолжить;
		КонецЕсли;
		
		// Проверяем, похожа ли строка на Base64
		СтрокаОчищенная = СтрЗаменить(Строка, " ", "");
		Если СтрДлина(СтрокаОчищенная) > 50 Тогда
			// Проверяем символы Base64
			ДопустимыеСимволы = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=";
			ВсеСимволыДопустимы = Истина;
			Для Счетчик = 1 По СтрДлина(СтрокаОчищенная) Цикл
				Символ = Сред(СтрокаОчищенная, Счетчик, 1);
				Если Найти(ДопустимыеСимволы, Символ) = 0 Тогда
					ВсеСимволыДопустимы = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если ВсеСимволыДопустимы Тогда
				Возврат СтрокаОчищенная;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Если не нашли в строках, пробуем весь текст
	Возврат "";
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// HWID - УНИКАЛЬНЫЙ ИДЕНТИФИКАТОР ОБОРУДОВАНИЯ
////////////////////////////////////////////////////////////////////////////////

&НаСервере
Функция Лице_ПолучитьHWID()
	
	// Собираем уникальные данные для идентификации
	// Комбинация должна быть стабильной, но уникальной для каждой базы
	
	HWIDЧасти = Новый Массив;
	
	// 1. Имя компьютера (сетевое имя)
	Попытка
		HWIDЧасти.Добавить(Врег(ИмяКомпьютера()));
	Исключение
		HWIDЧасти.Добавить("NO_HOST");
	КонецПопытки;
	
	// 2. Путь к базе данных (уникален для каждой копии)
	Попытка
		ПутьКБазе = СтрокаСоединенияИнформационнойБазы();
		// Нормализуем путь
		ПутьКБазе = СтрЗаменить(ПутьКБазе, "\", "/");
		ПутьКБазе = СтрЗаменить(ПутьКБазе, "//", "/");
		HWIDЧасти.Добавить(Врег(ПутьКБазе));
	Исключение
		HWIDЧасти.Добавить("NO_DB_PATH");
	КонецПопытки;
	
	// 3. Имя информационной базы
	Попытка
		ИмяИБ = БазоваяИнформационнаяБаза().Имя;
		HWIDЧасти.Добавить(Врег(ИмяИБ));
	Исключение
		HWIDЧасти.Добавить("NO_IB_NAME");
	КонецПопытки;
	
	// 4. Пользователь ОС (дополнительная привязка)
	Попытка
		ПользовательОС = ИмяПользователя();
		HWIDЧасти.Добавить(Врег(ПользовательОС));
	Исключение
		HWIDЧасти.Добавить("NO_USER");
	КонецПопытки;
	
	// Собираем все части в одну строку
	HWIDСтрока = СтрСоединить(HWIDЧасти, "|||");
	
	// Вычисляем хеш для получения компактного идентификатора
	HWID = Лице_ВычислитьХеш(HWIDСтрока);
	
	// Преобразуем в верхний регистр и убираем разделители
	HWID = Врег(СтрЗаменить(HWID, "-", ""));
	
	// Обрезаем до 32 символов (достаточно для уникальности)
	Если СтрДлина(HWID) > 32 Тогда
		HWID = Лев(HWID, 32);
	КонецЕсли;
	
	Возврат HWID;
	
КонецФункции

&НаСервере
Функция Лице_ПолучитьУникальныйИдентификатор()
	
	// Генерируем случайный идентификатор для каждого запроса
	// Это предотвращает повторное использование одного запроса
	
	СлучайныеДанные = "";
	Для Счетчик = 1 По 32 Цикл
		СлучайноеЧисло = СлучайноеЧисло(0, 255);
		СлучайныеДанные = СлучайныеДанные + Формат(СлучайноеЧисло, "ЧЦ=3");
	КонецЦикла;
	
	// Добавляем текущее время для уникальности
	СлучайныеДанные = СлучайныеДанные + Строка(ТекущаяДата());
	
	Возврат Лице_ВычислитьХеш(СлучайныеДанные);
	
КонецФункции

