	// Сериализуем лицензию в строку
	Сериализованные = Лице_СериализоватьЛицензию(Лицензия);
	
	// Шифруем данные
	Зашифрованные = Лице_ЗашифроватьДанные(Сериализованные);
	
	// Кодируем в Base64 для хранения
	Закодированные = Лице_КодироватьBase64(Зашифрованные);
	
	// Сохраняем во все доступные хранилища
	
	// 1. Файл
	Лице_СохранитьЛицензиюВФайл(Закодированные);
	
	// 2. Реестр Windows
	Лице_СохранитьЛицензиюВРеестр(Закодированные);
	
	// 3. База данных
	Лице_СохранитьЛицензиюВБД(Закодированные);
	
КонецПроцедуры

