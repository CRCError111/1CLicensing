// Сформировать лицензию на основе запроса пользователя
Функция СформироватьЛицензию(ТекстЗапроса, ГодНачала, ГодОкончания)
	
	Попытка
		
		// Извлекаем закодированный запрос из текста
		ЗакодированныйЗапрос = ИзвлечьЗапросИзТекста(ТекстЗапроса);
		
		Если ЗакодированныйЗапрос = "" Тогда
			Возврат "ERROR: Не удалось найти запрос в тексте. Проверьте формат.";
		КонецЕсли;
		
		// Декодируем Base64
		ДекодированныйЗапрос = ДекодироватьBase64(ЗакодированныйЗапрос);
		
		// Разбираем части запроса
		Части = СтрРазделить(ДекодированныйЗапрос, "|", Ложь);
		
		Если Части.Количество() < 5 Тогда
			Возврат "ERROR: Неверный формат запроса. Ожидалось минимум 5 полей, получено: " + Части.Количество();
		КонецЕсли;
		
		// Проверяем тип запроса
		Если Части[0] <> "REQUEST_LICENSE" Тогда
			Возврат "ERROR: Неверный тип запроса. Ожидался REQUEST_LICENSE, получено: " + Части[0];
		КонецЕсли;
		
		// Извлекаем данные
		HWID = Части[1];
		ДатаЗапроса = Части[2];
		ВерсияПлатформы = Части[3];
		УникальныйID = Части[4];
		КонтрольнаяСуммаЗапроса = Части[5];
		
		// Проверяем контрольную сумму запроса
		СтрокаДляПроверки = СтрСоединить(Части.ВыгрузитьЗначения(0, 5), "|");
		ОжидаемаяСумма = ВычислитьХеш(СтрокаДляПроверки + Гл_КлючПроверки);
		
		Если ОжидаемаяСумма <> КонтрольнаяСуммаЗапроса Тогда
			Возврат "ERROR: Неверная контрольная сумма запроса. Запрос мог быть изменен.";
		КонецЕсли;
		
		// Формируем ответ
		СтрокаОтвета = 
			"RESPONSE_LICENSE" + "|" +
			HWID + "|" +
			Строка(ГодНачала) + "|" +
			Строка(ГодОкончания);
		
		// Генерируем подпись лицензии
		Подпись = СгенерироватьПодпись(HWID, ГодНачала, ГодОкончания);
		СтрокаОтвета = СтрокаОтвета + "|" + Подпись;
		
		// Добавляем контрольную сумму ответа
		СтрокаДляКонтрольнойСуммы = HWID + "|" + Строка(ГодНачала) + "|" + Строка(ГодОкончания) + "|" + Подпись;
		КонтрольнаяСуммаОтвета = ВычислитьХеш(СтрокаДляКонтрольнойСуммы + Гл_КлючПроверки);
		СтрокаОтвета = СтрокаОтвета + "|" + КонтрольнаяСуммаОтвета;
		
		// Кодируем в Base64
		ЗакодированныйОтвет = КодироватьBase64(СтрокаОтвета);
		
		// Формируем итоговый текст для отправки пользователю
		ТекстДляОтправки = 
			"=== ОТВЕТ С ЛИЦЕНЗИЕЙ ===" + Символы.ПС +
			"Скопируйте этот текст и передайте пользователю:" + Символы.ПС + Символы.ПС +
			ЗакодированныйОтвет + Символы.ПС + Символы.ПС +
			"Лицензия выдана для HWID: " + HWID + Символы.ПС +
			"Период действия: " + ГодНачала + " - " + ГодОкончания + Символы.ПС +
			"=========================";
		
		Возврат ТекстДляОтправки;
		
	Исключение
		Возврат "ERROR: Исключение при формировании лицензии: " + ОписаниеОшибки();
	КонецПопытки;
	
КонецФункции

// Сгенерировать подпись для лицензии
Функция СгенерироватьПодпись(HWID, ГодНачала, ГодОкончания)
	
	// Формируем строку для подписи
	СтрокаДляПодписи = 
		HWID + "|" +
		Строка(ГодНачала) + "|" +
		Строка(ГодОкончания) + "|" +
		Гл_КлючПроверки + "|" +
		Строка(ТекущаяДата());
	
	// Вычисляем хеш
	Подпись = ВычислитьХеш(СтрокаДляПодписи);
	
	// Добавляем дополнительные символы для сложности
	Подпись = Подпись + "-" + Врег(Лев(HWID, 8));
	
	Возврат Подпись;
	
КонецФункции

// Извлечь запрос из текста пользователя
Функция ИзвлечьЗапросИзТекста(Текст)
	
	Строки = СтрРазделить(Текст, Символы.ПС, Ложь);
	
	Для Каждого Строка Из Строки Цикл
		// Пропускаем служебные строки
		Если СтрНачинаетсяС(Строка, "===") Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНачинаетсяС(Строка, "Скопируйте") Или СтрНачинаетсяС(Строка, "Отправьте") Тогда
			Продолжить;
		КонецЕсли;
		
		// Проверяем, похожа ли строка на Base64
		СтрокаОчищенная = СтрЗаменить(Строка, " ", "");
		Если СтрДлина(СтрокаОчищенная) > 50 Тогда
			// Проверяем символы Base64
			ДопустимыеСимволы = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=";
			ВсеСимволыДопустимы = Истина;
			Для Счетчик = 1 По СтрДлина(СтрокаОчищенная) Цикл
				Символ = Сред(СтрокаОчищенная, Счетчик, 1);
				Если Найти(ДопустимыеСимволы, Символ) = 0 Тогда
					ВсеСимволыДопустимы = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если ВсеСимволыДопустимы Тогда
				Возврат СтрокаОчищенная;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ (копии из модуля лицензирования)
////////////////////////////////////////////////////////////////////////////////

Функция ВычислитьХеш(Строка)
	
	Попытка
		
		Хеш1 = 0;
		Хеш2 = 0;
		Множитель1 = 31;
		Множитель2 = 37;
		Модуль = 2147483647;
		
		Для Счетчик = 1 По СтрДлина(Строка) Цикл
			
			КодСимвола = КодСимвола(Строка, Счетчик);
			
			Хеш1 = (Хеш1 * Множитель1 + КодСимвола) % Модуль;
			Хеш2 = (Хеш2 * Множитель2 + КодСимвола) % Модуль;
			
		КонецЦикла;
		
		ХешСтрока = "";
		Временный = Хеш1;
		Пока Временный > 0 Цикл
			Остаток = Временный % 16;
			Если Остаток < 10 Тогда
				ХешСтрока = Строка(Остаток) + ХешСтрока;
			Иначе
				ХешСтрока = Символ(КодСимвола("A") + Остаток - 10) + ХешСтрока;
			КонецЕсли;
			Временный = Цел(Временный / 16);
		КонецЦикла;
		
		Пока СтрДлина(ХешСтрока) < 16 Цикл
			ХешСтрока = "0" + ХешСтрока;
		КонецЦикла;
		
		ХешСтрока2 = "";
		Временный = Хеш2;
		Пока Временный > 0 Цикл
			Остаток = Временный % 16;
			Если Остаток < 10 Тогда
				ХешСтрока2 = Строка(Остаток) + ХешСтрока2;
			Иначе
				ХешСтрока2 = Символ(КодСимвола("A") + Остаток - 10) + ХешСтрока2;
			КонецЕсли;
			Временный = Цел(Временный / 16);
		КонецЦикла;
		
		Пока СтрДлина(ХешСтрока2) < 16 Цикл
			ХешСтрока2 = "0" + ХешСтрока2;
		КонецЦикла;
		
		Возврат ХешСтрока + ХешСтрока2;
		
	Исключение
		Возврат "00000000000000000000000000000000";
	КонецПопытки;
	
КонецФункции

Функция КодироватьBase64(Строка)
	
	Попытка
		ДвоичныеДанные = Новые ДвоичныеДанные(Строка);
		Кодированные = Base64Значение(ДвоичныеДанные);
		Возврат Кодированные;
	Исключение
		Возврат Строка;
	КонецПопытки;
	
КонецФункции

Функция ДекодироватьBase64(КодированнаяСтрока)
	
	Попытка
		ДвоичныеДанные = Base64Значение(КодированнаяСтрока);
		Возврат ДвоичныеДанные.ПолучитьСтроку();
	Исключение
		Возврат КодированнаяСтрока;
	КонецПопытки;
	
КонецФункции

